generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model column_catalog {
  id              BigInt    @id @default(autoincrement())
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)
  data_type       String    @db.VarChar
  is_sensitive    Boolean
  sensitive_tag   String    @db.VarChar
  null_count      Int       @db.SmallInt
  duplicate_count Int       @db.SmallInt
  invalid_values  Int       @db.SmallInt
  null_percentage Float     @db.Real
  dataset_id      BigInt
  datasets        datasets  @relation(fields: [dataset_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model dataset_access_log {
  id         BigInt    @id @default(autoincrement())
  viewed_at  DateTime  @default(now()) @db.Timestamptz(6)
  dataset_id BigInt?
  datasets   datasets? @relation(fields: [dataset_id], references: [id], onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model datasets {
  id                 BigInt               @id @default(autoincrement())
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  filename           String               @db.VarChar
  row_count          BigInt
  column_count       BigInt
  quality_score      Float                @db.Real
  trust_score        Float                @db.Real
  value_score        Float                @db.Real
  column_catalog     column_catalog[]
  dataset_access_log dataset_access_log[]
}
