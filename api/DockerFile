FROM node:22-alpine

WORKDIR /app

# Copy package.json and package-lock.json
COPY package*.json ./

# Install dependencies (with --omit=dev for production)
RUN npm ci --omit=dev

# Copy Prisma schema and source code BEFORE build
COPY prisma ./prisma/
COPY src ./src/
COPY tsconfig.json tsup.config.ts ./

# Build the application
RUN npm run build

# Expose port and start
EXPOSE 3000
CMD ["npm", "start"]